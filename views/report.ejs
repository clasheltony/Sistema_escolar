<%- include('header') %>

<div class="mb-4 d-flex justify-content-between align-items-center">
  <h2>Relatório Geral</h2>
  <form action="/report" method="GET" class="d-flex w-75 justify-content-end">
    <select name="classId" class="form-select me-2 w-50" onchange="this.form.submit()">
      <% classes.forEach(function(c) { %>
        <option value="<%= c.id %>" <%= (selectedClass && selectedClass.id === c.id) ? 'selected' : '' %>><%= c.name %></option>
      <% }); %>
      <% if (classes.length === 0) { %>
        <option value="">Nenhuma turma disponível</option>
      <% } %>
    </select>
    <select name="bimesterId" class="form-select w-50" onchange="this.form.submit()">
      <option value="">Visão Geral (Ano Completo)</option>
      <% bimesters.forEach(function(b) { %>
        <option value="<%= b.id %>" <%= (selectedBimesterId == b.id) ? 'selected' : '' %>><%= b.name %></option>
      <% }); %>
    </select>
  </form>
</div>

<% if (selectedClass) { %>
  <div class="card p-4 shadow-sm" id="report-card">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
      <h4 class="mb-0">Boletim Consolidado - <%= selectedClass.name %></h4>
      <div data-html2pdf-ignore="true">
        <button onclick="exportToExcel()" class="btn btn-outline-success btn-sm me-2 d-inline-flex align-items-center gap-1">
          <i class="bi bi-file-earmark-excel"></i> Exportar Excel
        </button>
        <button onclick="exportToPDF()" class="btn btn-outline-danger btn-sm d-inline-flex align-items-center gap-1">
          <i class="bi bi-file-earmark-pdf"></i> Exportar PDF
        </button>
      </div>
    </div>
    <div class="table-responsive">
      <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
          <tr>
            <th>Matrícula</th>
            <th>Nome do Aluno</th>
            <th>Frequência (%)</th>
            <th>Vistos</th>
            <th>Prova (AVI)</th>
            <th>Prática</th>
            <th>Av. Contínua</th>
            <th>Média Final</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% if (reportData.length > 0) { %>
            <% reportData.forEach(function(r) { %>
              <% var isAprovado = parseFloat(r.mediaBimestral) >= 6 && parseFloat(r.attendanceRate) >= 75; %>
              <tr>
                <td><%= r.student.enrollment || '-' %></td>
                <td class="fw-bold"><%= r.student.name %></td>
                <td>
                  <span class="badge bg-<%= parseFloat(r.attendanceRate) >= 75 ? 'success' : 'danger' %>"><%= r.attendanceRate %>%</span>
                </td>
                <td><%= r.vistoStatus %></td>
                <td><%= r.notaAVI.toFixed(1) %></td>
                <td><%= r.notaPratica.toFixed(1) %></td>
                <td><span class="text-info fw-bold"><%= r.avaliacaoContinua.toFixed(1) %></span></td>
                <td><span class="fs-5 <%= isAprovado ? 'text-success' : 'text-danger' %>"><%= r.mediaBimestral.toFixed(1) %></span></td>
                <td>
                  <% if (isAprovado) { %>
                    <span class="badge bg-success"><i class="bi bi-check-circle"></i> Aprovado</span>
                  <% } else { %>
                    <span class="badge bg-danger"><i class="bi bi-exclamation-circle"></i> Reprovado</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="9" class="text-center">Nenhum aluno ou dado registrado.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Scripts de Exportação -->
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
  <script>
    function exportToExcel() {
      const table = document.querySelector('table');
      if (!table) return;

      const className = <%- JSON.stringify(selectedClass ? selectedClass.name : "Turma") %>;
      const bimesterName = <%- JSON.stringify(selectedBimesterId && bimesters.find(b => b.id == selectedBimesterId) ? bimesters.find(b => b.id == selectedBimesterId).name : "Ano_Completo") %>;
      
      const cleanClassName = className.replace(/\s+/g, '_');
      const cleanBimesterName = bimesterName.replace(/\s+/g, '_');
      const filename = `Relatorio_${cleanClassName}_${cleanBimesterName}.xlsx`;

      // Clonar tabela para limpar elementos visuais como badges e ícones para o Excel
      const clonedTable = table.cloneNode(true);
      
      // Remover badges de Bootstrap e deixar apenas texto limpo
      clonedTable.querySelectorAll('.badge').forEach(badge => {
        badge.innerText = badge.textContent.trim();
      });

      const wb = XLSX.utils.table_to_book(clonedTable, { sheet: "Relatório" });
      XLSX.writeFile(wb, filename);
    }

    function exportToPDF() {
      const element = document.getElementById('report-card');
      if (!element) return;

      const className = <%- JSON.stringify(selectedClass ? selectedClass.name : "Turma") %>;
      const bimesterName = <%- JSON.stringify(selectedBimesterId && bimesters.find(b => b.id == selectedBimesterId) ? bimesters.find(b => b.id == selectedBimesterId).name : "Ano_Completo") %>;
      
      const cleanClassName = className.replace(/\s+/g, '_');
      const cleanBimesterName = bimesterName.replace(/\s+/g, '_');
      const filename = `Relatorio_${cleanClassName}_${cleanBimesterName}.pdf`;

      const opt = {
        margin:       [10, 10, 10, 10],
        filename:     filename,
        image:        { type: 'jpeg', quality: 0.98 },
        html2canvas:  { scale: 2, useCORS: true, logging: false },
        jsPDF:        { unit: 'mm', format: 'a4', orientation: 'landscape' }
      };

      html2pdf().set(opt).from(element).save();
    }
  </script>
<% } else { %>
  <p class="text-muted">Selecione uma turma para visualizar o relatório.</p>
<% } %>

<%- include('footer') %>
