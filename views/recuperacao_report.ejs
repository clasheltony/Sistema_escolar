<%- include('header') %>

<div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div>
    <h2><i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>Alunos em Recuperação (AVI)</h2>
    <p class="text-muted">Lista de alunos habilitados para a recuperação (nota original da Prova AVI menor que 6.0).</p>
  </div>
  <form action="/reports/recuperacao" method="GET" class="d-flex align-items-center gap-2">
    <label class="fw-bold text-nowrap mb-0 me-1">Filtrar:</label>
    <select name="bimesterId" class="form-select w-auto" onchange="this.form.submit()">
      <option value="">Visão Geral (Ano Completo)</option>
      <% bimesters.forEach(function(b) { %>
        <option value="<%= b.id %>" <%= (selectedBimesterId == b.id) ? 'selected' : '' %>><%= b.name %></option>
      <% }); %>
    </select>
  </form>
</div>

<% if (classesReport.length > 0) { %>
  <div class="d-flex justify-content-end mb-3" data-html2pdf-ignore="true">
    <button onclick="exportToExcel()" class="btn btn-outline-success me-2 d-inline-flex align-items-center gap-1">
      <i class="bi bi-file-earmark-excel"></i> Exportar Excel
    </button>
    <button onclick="exportToPDF()" class="btn btn-outline-danger d-inline-flex align-items-center gap-1">
      <i class="bi bi-file-earmark-pdf"></i> Exportar PDF
    </button>
  </div>

  <div id="recuperacao-report-container">
    <% classesReport.forEach(function(cr) { %>
      <div class="card p-0 shadow-sm mb-4 border-0 overflow-hidden b-class-card">
        <!-- Cabeçalho com Degradê Premium -->
        <div class="card-header bg-gradient bg-primary text-white p-3 d-flex justify-content-between align-items-center flex-wrap gap-2" style="background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);">
          <h5 class="mb-0 fw-bold">
            <i class="bi bi-people-fill me-2"></i><%= cr.classInfo.name %>
          </h5>
          <span class="badge bg-light text-primary fw-bold fs-6 shadow-sm">
            Disciplina: <%= cr.classInfo.subject || 'Sem disciplina' %>
          </span>
        </div>
        
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th class="ps-3">Matrícula</th>
                  <th>Nome do Aluno</th>
                </tr>
              </thead>
              <tbody>
                <% cr.students.forEach(function(r) { %>
                  <tr class="<%= !r.student.active ? 'opacity-75 bg-light' : '' %>">
                    <td class="ps-3"><%= r.student.enrollment || '-' %></td>
                    <td class="fw-bold <%= !r.student.active ? 'text-decoration-line-through text-muted' : '' %>">
                      <%= r.student.name %>
                      <% if (!r.student.active) { %>
                        <span class="badge bg-secondary text-dark small ms-1" style="font-size: 0.6rem; opacity: 0.7;">Transferido</span>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    <% }); %>
  </div>

  <!-- Scripts de Exportação -->
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
  <script>
    function exportToExcel() {
      const container = document.getElementById('recuperacao-report-container');
      if (!container) return;

      const wb = XLSX.utils.book_new();

      // Vamos criar uma aba para cada turma para ficar super organizado!
      const cards = container.querySelectorAll('.b-class-card');
      cards.forEach(card => {
        const titleEl = card.querySelector('.card-header h5');
        const subjectEl = card.querySelector('.card-header span');
        const table = card.querySelector('table');
        if (!table) return;

        let titleText = titleEl ? titleEl.textContent.trim() : "Turma";
        // Limpar o nome da planilha (máx 31 caracteres, sem caracteres especiais)
        let sheetName = titleText.replace(/[\[\]\*\?:\/\\]/g, '').substring(0, 30);
        if (!sheetName) sheetName = "Turma";

        const clonedTable = table.cloneNode(true);
        // Limpar os elementos HTML (badges) das células para deixar apenas texto limpo
        clonedTable.querySelectorAll('.badge').forEach(badge => {
          badge.innerText = badge.textContent.trim();
        });

        const ws = XLSX.utils.table_to_sheet(clonedTable);
        XLSX.utils.book_append_sheet(wb, ws, sheetName);
      });

      const bimesterName = <%- JSON.stringify(selectedBimesterId && bimesters.find(b => b.id == selectedBimesterId) ? bimesters.find(b => b.id == selectedBimesterId).name : "Ano_Completo") %>;
      const cleanBimesterName = bimesterName.replace(/\s+/g, '_');
      XLSX.writeFile(wb, `Relatorio_Recuperacao_${cleanBimesterName}.xlsx`);
    }

    function exportToPDF() {
      const element = document.getElementById('recuperacao-report-container');
      if (!element) return;

      const bimesterName = <%- JSON.stringify(selectedBimesterId && bimesters.find(b => b.id == selectedBimesterId) ? bimesters.find(b => b.id == selectedBimesterId).name : "Ano_Completo") %>;
      const cleanBimesterName = bimesterName.replace(/\s+/g, '_');
      const filename = `Relatorio_Recuperacao_${cleanBimesterName}.pdf`;

      // Criar cabeçalho temporário para aparecer no PDF de forma bonita
      const headerPDF = document.createElement('div');
      headerPDF.innerHTML = `
        <div style="text-align: center; margin-bottom: 20px; border-bottom: 2px solid #0d6efd; padding-bottom: 10px;">
          <h2 style="color: #0d6efd; margin-bottom: 5px;">Sistema Gestão Escolar</h2>
          <h3 style="margin: 0; color: #495057;">Relatório Geral de Alunos em Recuperação (AVI)</h3>
          <p style="margin: 5px 0 0 0; font-size: 0.9rem; color: #6c757d;">Período: ${bimesterName.replace('_', ' ')}</p>
        </div>
      `;
      
      // Envolver o relatório em uma cópia para impressão
      const printWrapper = document.createElement('div');
      printWrapper.appendChild(headerPDF);
      printWrapper.appendChild(element.cloneNode(true));

      const opt = {
        margin:       [12, 12, 12, 12],
        filename:     filename,
        image:        { type: 'jpeg', quality: 0.98 },
        html2canvas:  { scale: 2, useCORS: true, logging: false },
        jsPDF:        { unit: 'mm', format: 'a4', orientation: 'landscape' }
      };

      html2pdf().set(opt).from(printWrapper).save();
    }
  </script>
<% } else { %>
  <div class="card p-5 text-center shadow-sm border-0 bg-white">
    <div class="my-3">
      <i class="bi bi-emoji-smile text-success fs-1"></i>
    </div>
    <h4>Nenhum aluno em recuperação!</h4>
    <p class="text-muted">Todos os alunos estão com nota igual ou superior a 6.0 na Prova (AVI) no período selecionado.</p>
  </div>
<% } %>

<%- include('footer') %>
