<%- include('header') %>

<div class="row justify-content-center mt-5">
  <div class="col-md-5">
    <div class="card p-4">
      <div class="text-center mb-4">
        <h2 class="text-primary"><i class="bi bi-shield-lock-fill"></i></h2>
        <h4>Redefinir senha</h4>
        <p class="text-muted">Escolha uma nova senha para sua conta.</p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <% if (token) { %>
        <form action="/reset-password/<%= token %>" method="POST">
          <div class="mb-3">
            <label class="form-label">Nova senha</label>
            <input type="password" name="password" class="form-control" required minlength="6" placeholder="Mínimo 6 caracteres">
          </div>
          <div class="mb-3">
            <label class="form-label">Confirmar nova senha</label>
            <input type="password" name="confirmPassword" class="form-control" required minlength="6" placeholder="Repita a senha">
          </div>
          <button type="submit" class="btn btn-primary w-100">Salvar nova senha</button>
        </form>
      <% } else { %>
        <p class="text-center mb-0"><a href="/forgot-password">Solicitar novo link</a></p>
      <% } %>
    </div>
  </div>
</div>

<%- include('footer') %>
