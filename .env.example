# Configuracoes do Banco de Dados - Supabase (OBRIGATORIO)
# Copie este arquivo para .env e preencha com suas credenciais.
# NUNCA commite o arquivo .env.
#
# IMPORTANTE: use sempre o POOLER (Supabase > Connect > Transaction pooler).
#   Host: aws-<n>-<regiao>.pooler.supabase.com   Porta: 6543
#   Usuario: postgres.<ref-do-projeto>   (NAO use a conexao direta db.<ref>.supabase.co:5432)
#   Se a senha tiver caracteres especiais, percent-encode (ex: @ -> %40).
DATABASE_URL=postgresql://postgres.SEU_REF:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres

# Configuracao da Sessao (recomendado em producao)
SESSION_SECRET=troque_por_uma_chave_aleatoria_longa
PORT=3000

# URL publica do sistema (usada para montar os links nos e-mails).
# Local: http://localhost:3000 . Em producao: a URL do Render.
APP_URL=http://localhost:3000

# Envio de e-mail - Gmail com "senha de app".
# Crie em: https://myaccount.google.com/apppasswords (precisa de 2FA ativo)
# Sem isso, o sistema entra em modo dev e apenas mostra o e-mail no console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua_senha_de_app
MAIL_FROM="Sistema Escolar <seuemail@gmail.com>"
